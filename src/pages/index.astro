---
import { projects } from "../data/projects";

const primaryLinks = [
	{ label: "GitHub", href: "https://github.com/corwinm" },
	{ label: "HaphazardDev", href: "https://github.com/HaphazardDev" },
];

const mapPositions: Record<string, string> = {
	"oil-code": "northwest",
	arashi: "northeast",
	"coding-agents-tmux": "southwest",
	"pi-extensions": "southeast",
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex,nofollow" />
		<meta
			name="description"
			content="Project Atlas: a field guide to Corwin's connected developer tools, extensions, CLIs, and workflow experiments."
		/>
		<meta name="theme-color" content="#f4f1e7" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>Project Atlas — Haphazard.dev</title>
	</head>
	<body id="top">
		<a class="skip-link" href="#project-guide">Skip to project guide</a>

		<header class="site-header">
			<a class="brand" href="/" aria-label="Haphazard.dev home">
				<svg viewBox="0 0 38 38" aria-hidden="true">
					<circle cx="19" cy="19" r="16"></circle>
					<path d="M10 23c3-7 6-10 13-13M15 28c2-5 6-9 13-12"></path>
					<circle cx="23" cy="13" r="2.5"></circle>
				</svg>
				<span>haphazard.dev</span>
			</a>
			<nav aria-label="Primary navigation">
				<a href="#atlas">Atlas</a>
				<a href="#project-guide">Field guide</a>
				{primaryLinks.map((link) => (
					<a href={link.href} target="_blank" rel="noreferrer">{link.label}<span class="external" aria-hidden="true">↗</span></a>
				))}
			</nav>
		</header>

		<main>
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="kicker"><span>Project Atlas</span><span>42.36° N · 71.06° W</span></p>
					<h1 id="hero-title">Build the trail,<br />not the tollbooth.</h1>
					<p class="lede">
						A field guide to small, connected tools that clear a path through editors,
						worktrees, terminals, and coding-agent workflows.
					</p>
				</div>
				<div class="hero-mark" aria-hidden="true">
					<svg viewBox="0 0 230 230">
						<circle cx="115" cy="115" r="103"></circle>
						<circle cx="115" cy="115" r="81"></circle>
						<circle cx="115" cy="115" r="56"></circle>
						<path d="M35 145c35-9 55-44 87-40s42 28 75 8"></path>
						<path d="M44 165c27-11 42-31 69-30 37 1 44 25 79 15"></path>
						<path class="needle" d="m98 132 22-59 13 56-35 3Z"></path>
					</svg>
				</div>
			</section>

			<section id="atlas" class="atlas-section" aria-labelledby="atlas-title">
				<div class="section-intro">
					<div>
						<p class="overline">Plate 01 · The working landscape</p>
						<h2 id="atlas-title">An ecosystem, not an inventory.</h2>
					</div>
					<div class="atlas-control">
						<button class="route-toggle" type="button" aria-pressed="false" aria-controls="project-map">
							<span class="toggle-icon" aria-hidden="true"></span>
							Trace a working route
						</button>
						<p id="route-status" class="route-status" aria-live="polite">All project regions are visible.</p>
					</div>
				</div>

				<div id="project-map" class="project-map" data-route="overview">
					<svg class="contours" viewBox="0 0 1200 680" preserveAspectRatio="none" aria-hidden="true">
						<path d="M-40 150C120 5 310 29 396 120s210 78 304-2 250-91 540 32"></path>
						<path d="M-25 197C132 61 282 77 381 159s237 89 338 6 249-91 510 34"></path>
						<path d="M-5 248c169-107 291-89 390-25s223 84 340 8 267-68 499 35"></path>
						<path d="M-20 540c162-120 307-93 418-22s224 49 312-14 279-105 526 31"></path>
						<path d="M-33 588c166-105 309-80 414-17s232 57 346-10 270-81 504 29"></path>
						<path d="M328-10c-40 104-14 185 57 229s72 137 21 210-33 181 41 261"></path>
						<path d="M845-20c-61 93-52 188 12 249s37 148-23 213-58 158 5 250"></path>
					</svg>

					<svg class="routes" viewBox="0 0 1200 680" preserveAspectRatio="none" aria-hidden="true">
						<path class="route route-a" d="M245 208C390 110 495 152 620 220S807 288 951 203"></path>
						<path class="route route-b" d="M247 215C267 347 352 425 454 494S718 593 927 478"></path>
						<path class="route route-c" d="M950 211C871 285 817 357 767 425S638 510 456 496"></path>
					</svg>

					<div class="map-key" aria-hidden="true">
						<span>EDIT</span><i></i><span>ORCHESTRATE</span><i></i><span>OBSERVE</span><i></i><span>EXTEND</span>
					</div>

					{projects.map((project, index) => (
						<a
							class={`map-node ${mapPositions[project.slug]}`}
							href={`#${project.slug}`}
							style={`--route-order: "0${index + 1}"`}
							aria-label={`Read about ${project.title}, ${project.category}`}
						>
							<span class="node-pin" aria-hidden="true"><i></i></span>
							<span class="node-copy">
								<small>{project.category}</small>
								<strong>{project.title}</strong>
								<em>Open field note <span aria-hidden="true">↘</span></em>
							</span>
						</a>
					))}

					<div class="scale" aria-hidden="true"><span>0</span><i></i><i></i><i></i><i></i><span>4 projects</span></div>
					<div class="north" aria-label="Map orientation: north"><span>N</span><i></i></div>
				</div>
			</section>

			<section id="project-guide" class="project-guide" aria-labelledby="guide-title">
				<div class="guide-heading">
					<p class="overline">Field notes · Full project details</p>
					<h2 id="guide-title">Places worth exploring.</h2>
					<p>This readable guide contains the complete project details and destinations shown on the map.</p>
				</div>

				<div class="guide-list">
					{projects.map((project, index) => (
						<article class="guide-entry" id={project.slug}>
							<header>
								<span class="entry-number">{String(index + 1).padStart(2, "0")}</span>
								<div>
									<p>{project.category}</p>
									<h3>{project.title}</h3>
								</div>
							</header>
							<div class="entry-body">
								<div class="entry-description">
									<p>{project.description}</p>
									<ul aria-label={`${project.title} highlights`}>
										{project.highlights.map((highlight) => <li>{highlight}</li>)}
									</ul>
								</div>
								<aside aria-label={`${project.title} technologies and links`}>
									<div class="technologies">
										<span>Terrain</span>
										<p>{project.technologies.join(" · ")}</p>
									</div>
									<div class="project-links">
										{project.links.map((link) => (
											<a href={link.href} target="_blank" rel="noreferrer">
												{link.label}<span aria-hidden="true">↗</span>
											</a>
										))}
									</div>
								</aside>
							</div>
						</article>
					))}
				</div>
			</section>
		</main>

		<footer>
			<p>Haphazard.dev <span>·</span> Tools for the route ahead.</p>
			<p>© {new Date().getFullYear()} Corwin</p>
			<a href="#top" onclick="window.scrollTo({ top: 0, behavior: 'smooth' }); return false;">Return north ↑</a>
		</footer>

		<script is:inline>
			const toggle = document.querySelector('.route-toggle');
			const map = document.querySelector('#project-map');
			const status = document.querySelector('#route-status');

			toggle?.addEventListener('click', () => {
				const active = toggle.getAttribute('aria-pressed') !== 'true';
				toggle.setAttribute('aria-pressed', String(active));
				map?.setAttribute('data-route', active ? 'active' : 'overview');
				if (status) {
					status.textContent = active
						? 'Route traced: edit, orchestrate, observe, then extend.'
						: 'All project regions are visible.';
				}
			});
		</script>
	</body>
</html>

<style is:global>
	@import url("https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Manrope:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap");

	:root {
		--paper: #f4f1e7;
		--paper-light: #fbfaf5;
		--ink: #18352d;
		--ink-soft: #51685f;
		--line: #b8c3b6;
		--moss: #3d735e;
		--moss-light: #dce6d4;
		--clay: #9b4b2e;
		--water: #89b6b4;
		font-family: "Manrope", sans-serif;
		background: var(--paper);
		color: var(--ink);
	}

	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; overflow-x: clip; }
	body {
		margin: 0;
		min-width: 0;
		overflow-x: clip;
		background:
			linear-gradient(rgba(24, 53, 45, 0.025) 1px, transparent 1px),
			linear-gradient(90deg, rgba(24, 53, 45, 0.025) 1px, transparent 1px),
			var(--paper);
		background-size: 28px 28px;
		color: var(--ink);
	}
	a { color: inherit; }
	:focus-visible { outline: 3px solid var(--clay); outline-offset: 4px; }
	::selection { background: #d9a68d; color: #102d25; }

	.skip-link {
		position: fixed;
		top: 1rem;
		left: 1rem;
		z-index: 100;
		transform: translateY(-180%);
		border: 1px solid var(--ink);
		border-radius: 999px;
		background: var(--paper-light);
		padding: .75rem 1rem;
		font-weight: 700;
		text-decoration: none;
	}
	.skip-link:focus { transform: translateY(0); }

	.site-header,
	main,
	footer { width: min(1240px, calc(100% - 3rem)); margin-inline: auto; }

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		border-bottom: 1px solid var(--line);
		padding: 1.25rem 0;
	}
	.brand { display: inline-flex; align-items: center; gap: .65rem; font-weight: 700; text-decoration: none; }
	.brand svg { width: 32px; fill: none; stroke: currentColor; stroke-width: 1.2; }
	.site-header nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .4rem 1.5rem; }
	.site-header nav a { padding: .35rem 0; color: var(--ink-soft); font-size: .84rem; font-weight: 600; text-decoration: none; }
	.site-header nav a:hover { color: var(--clay); }
	.external { margin-left: .2rem; font-size: .75em; }

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 280px;
		align-items: end;
		gap: 3rem;
		min-height: 570px;
		padding: 7rem 0 5rem;
	}
	.kicker, .overline {
		font-family: "DM Mono", monospace;
		font-size: .72rem;
		letter-spacing: .12em;
		text-transform: uppercase;
	}
	.kicker { display: flex; gap: 1.5rem; margin: 0 0 2rem; color: var(--ink-soft); }
	.kicker span:first-child { color: var(--clay); font-weight: 500; }
	h1, h2, h3 { font-family: "Newsreader", serif; font-weight: 500; }
	h1 { max-width: 920px; margin: 0; font-size: clamp(4.3rem, 10vw, 9.4rem); line-height: .78; letter-spacing: -.065em; }
	.lede { max-width: 650px; margin: 2.5rem 0 0 12%; color: var(--ink-soft); font-size: clamp(1.05rem, 1.8vw, 1.32rem); line-height: 1.65; }
	.hero-mark { align-self: center; opacity: .75; }
	.hero-mark svg { width: 100%; fill: none; stroke: var(--moss); stroke-width: .75; }
	.hero-mark .needle { fill: var(--clay); fill-opacity: .17; stroke: var(--clay); stroke-width: 1.2; }

	.atlas-section { padding: 4rem 0 8rem; }
	.section-intro { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
	.overline { margin: 0 0 .8rem; color: var(--clay); }
	h2 { margin: 0; font-size: clamp(2.8rem, 6vw, 5.5rem); line-height: .92; letter-spacing: -.045em; }
	.atlas-control { text-align: right; }
	.route-toggle {
		display: inline-flex;
		align-items: center;
		gap: .7rem;
		min-height: 44px;
		border: 1px solid var(--moss);
		border-radius: 999px;
		background: transparent;
		padding: .65rem 1rem;
		color: var(--ink);
		font: 600 .83rem "Manrope", sans-serif;
		cursor: pointer;
	}
	.route-toggle:hover, .route-toggle[aria-pressed="true"] { background: var(--ink); color: var(--paper-light); }
	.toggle-icon { width: 9px; height: 9px; border-radius: 50%; background: var(--clay); box-shadow: 0 0 0 4px rgba(201, 117, 81, .18); }
	.route-status { margin: .5rem 0 0; color: var(--ink-soft); font-size: .7rem; }

	.project-map {
		position: relative;
		isolation: isolate;
		height: min(680px, 62vw);
		min-height: 570px;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 48% 52% 6% 6% / 8% 8% 4% 4%;
		background:
			radial-gradient(circle at 19% 28%, rgba(220, 230, 212, .95) 0 5%, transparent 19%),
			radial-gradient(circle at 79% 30%, rgba(137, 182, 180, .27) 0 4%, transparent 23%),
			radial-gradient(circle at 36% 77%, rgba(201, 117, 81, .1) 0 4%, transparent 21%),
			linear-gradient(145deg, rgba(255,255,255,.56), rgba(220,230,212,.42));
	}
	.contours, .routes { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
	.contours { z-index: -2; fill: none; stroke: rgba(61, 115, 94, .23); stroke-width: 1; }
	.routes { z-index: -1; fill: none; stroke: var(--clay); stroke-width: 1.4; stroke-dasharray: 5 8; opacity: .45; }
	.project-map[data-route="active"] .route { stroke-width: 3; stroke-dasharray: 10 5; opacity: 1; animation: route-flow 1.2s linear infinite; }
	@keyframes route-flow { to { stroke-dashoffset: -30; } }

	.map-key {
		position: absolute;
		top: 1.6rem;
		left: 50%;
		display: flex;
		align-items: center;
		gap: .5rem;
		transform: translateX(-50%);
		color: var(--ink-soft);
		font: 400 .58rem "DM Mono", monospace;
		letter-spacing: .12em;
		white-space: nowrap;
	}
	.map-key i { width: 18px; border-top: 1px solid var(--line); }
	.map-node { position: absolute; display: flex; align-items: flex-start; gap: .9rem; color: var(--ink); text-decoration: none; }
	.map-node.northwest { top: 26%; left: 16%; }
	.map-node.northeast { top: 25%; right: 13%; }
	.map-node.southwest { bottom: 19%; left: 31%; }
	.map-node.southeast { right: 17%; bottom: 19%; }
	.node-pin { display: grid; flex: 0 0 27px; place-items: center; width: 27px; height: 27px; margin-top: 4px; border: 1px solid var(--ink); border-radius: 50%; background: rgba(244,241,231,.85); transition: transform .2s ease, background .2s ease; }
	.node-pin i { width: 7px; height: 7px; border-radius: 50%; background: var(--clay); }
	.node-copy { display: flex; flex-direction: column; align-items: flex-start; text-shadow: 0 1px 0 var(--paper); }
	.node-copy small { color: var(--ink-soft); font: 400 .64rem "DM Mono", monospace; letter-spacing: .08em; text-transform: uppercase; }
	.node-copy strong { margin-top: .2rem; font-family: "Newsreader", serif; font-size: clamp(1.45rem, 2.4vw, 2.25rem); font-weight: 500; line-height: 1; }
	.node-copy em { margin-top: .5rem; color: var(--moss); font-size: .7rem; font-style: normal; font-weight: 700; opacity: 0; transform: translateY(-4px); transition: opacity .2s, transform .2s; }
	.map-node:hover .node-pin, .map-node:focus-visible .node-pin { transform: scale(1.18); background: var(--paper-light); }
	.map-node:hover .node-copy em, .map-node:focus-visible .node-copy em { opacity: 1; transform: translateY(0); }
	.project-map[data-route="active"] .map-node::before {
		position: absolute;
		top: -25px;
		left: 4px;
		content: var(--route-order);
		color: var(--clay);
		font: 500 .65rem "DM Mono", monospace;
	}
	.project-map[data-route="active"] .node-pin { background: var(--ink); border-color: var(--ink); }
	.project-map[data-route="active"] .node-pin i { background: var(--paper-light); }
	.scale { position: absolute; bottom: 1.4rem; left: 1.8rem; display: flex; align-items: end; color: var(--ink-soft); font: .55rem "DM Mono", monospace; }
	.scale i { display: block; width: 24px; height: 7px; border: 1px solid var(--ink-soft); border-right: 0; }
	.scale i:nth-of-type(odd) { background: var(--ink-soft); }
	.scale span { margin: 0 .4rem; }
	.north { position: absolute; right: 1.8rem; bottom: 1.4rem; display: grid; justify-items: center; color: var(--ink-soft); font: .65rem "DM Mono", monospace; }
	.north i { width: 1px; height: 24px; margin-top: .25rem; background: var(--ink-soft); }

	.project-guide { display: grid; grid-template-columns: minmax(220px, .62fr) minmax(0, 1.38fr); gap: clamp(3rem, 8vw, 8rem); border-top: 1px solid var(--line); padding: 7rem 0; }
	.guide-heading { position: sticky; top: 2rem; align-self: start; }
	.guide-heading h2 { font-size: clamp(3rem, 5vw, 5.2rem); }
	.guide-heading > p:last-child { max-width: 38ch; margin-top: 1.5rem; color: var(--ink-soft); line-height: 1.7; }
	.guide-list { border-top: 1px solid var(--ink); }
	.guide-entry { scroll-margin-top: 2rem; border-bottom: 1px solid var(--line); padding: 2rem 0 2.5rem; }
	.guide-entry header { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 1rem; }
	.entry-number { color: var(--clay); font: .7rem "DM Mono", monospace; }
	.guide-entry header p { margin: 0 0 .3rem; color: var(--ink-soft); font: .66rem "DM Mono", monospace; letter-spacing: .08em; text-transform: uppercase; }
	.guide-entry h3 { margin: 0; font-size: clamp(2.4rem, 4.5vw, 4.4rem); line-height: .9; letter-spacing: -.04em; overflow-wrap: anywhere; }
	.entry-body { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(170px, .8fr); gap: 2rem; margin: 1.8rem 0 0 4rem; }
	.entry-description > p { margin-top: 0; font-size: 1rem; line-height: 1.7; }
	.entry-description ul { margin: 1.2rem 0 0; padding-left: 1.1rem; color: var(--ink-soft); font-size: .84rem; line-height: 1.65; }
	.entry-description li + li { margin-top: .45rem; }
	.entry-body aside { border-left: 1px solid var(--line); padding-left: 1.5rem; }
	.technologies span { color: var(--clay); font: .62rem "DM Mono", monospace; letter-spacing: .1em; text-transform: uppercase; }
	.technologies p { margin: .5rem 0 1.4rem; color: var(--ink-soft); font-size: .75rem; line-height: 1.65; }
	.project-links { display: flex; flex-wrap: wrap; gap: .45rem; }
	.project-links a { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; min-height: 44px; border-bottom: 1px solid var(--ink); padding: .55rem .15rem; font-size: .76rem; font-weight: 700; text-decoration: none; }
	.project-links a:hover { color: var(--clay); border-color: var(--clay); }

	footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--line); padding: 2rem 0 3rem; color: var(--ink-soft); font: .68rem "DM Mono", monospace; }
	footer p { margin: 0; }
	footer a { font-weight: 500; text-decoration: none; }
	footer span { color: var(--clay); }

	@media (max-width: 850px) {
		.site-header { align-items: flex-start; }
		.site-header nav { max-width: 420px; }
		.hero { grid-template-columns: 1fr; min-height: auto; padding-top: 6rem; }
		.hero-mark { display: none; }
		.section-intro { align-items: flex-start; flex-direction: column; }
		.atlas-control { text-align: left; }
		.project-map { height: 680px; min-height: 0; border-radius: 28px; }
		.map-node.northwest { top: 20%; left: 10%; }
		.map-node.northeast { top: 35%; right: 8%; }
		.map-node.southwest { bottom: 30%; left: 12%; }
		.map-node.southeast { right: 12%; bottom: 12%; }
		.project-guide { grid-template-columns: 1fr; }
		.guide-heading { position: static; }
	}

	@media (max-width: 600px) {
		.site-header, main, footer { width: min(100% - 2rem, 1240px); }
		.site-header { display: block; }
		.site-header nav { justify-content: flex-start; margin-top: 1rem; gap: .25rem 1rem; }
		.site-header nav a { min-height: 40px; }
		.kicker { align-items: flex-start; flex-direction: column; gap: .5rem; }
		h1 { font-size: clamp(3.5rem, 18vw, 5.7rem); }
		.lede { margin-left: 0; }
		.atlas-section { padding-bottom: 6rem; }
		.project-map { height: auto; min-height: 0; border-radius: 24px; padding: 4.5rem 1rem 4.5rem; }
		.contours, .routes, .map-key { display: none; }
		.map-node, .map-node.northwest, .map-node.northeast, .map-node.southwest, .map-node.southeast {
			position: relative;
			top: auto; right: auto; bottom: auto; left: auto;
			width: 100%;
			min-height: 92px;
			border-bottom: 1px solid rgba(24,53,45,.2);
			padding: 1.15rem .35rem;
		}
		.map-node:last-of-type { border-bottom: 0; }
		.node-copy em { opacity: 1; transform: none; }
		.project-map[data-route="active"] .map-node::before { top: 1.4rem; right: .25rem; left: auto; }
		.scale { left: 1rem; bottom: 1rem; }
		.north { right: 1rem; bottom: 1rem; }
		.project-guide { padding: 5rem 0; }
		.entry-body { grid-template-columns: 1fr; margin-left: 0; }
		.entry-body aside { border-top: 1px solid var(--line); border-left: 0; padding-top: 1.4rem; padding-left: 0; }
		footer { flex-direction: column; }
	}

	@media (prefers-reduced-motion: reduce) {
