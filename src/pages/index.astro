---
import { projects } from "../data/projects";

const site = Astro.site ?? new URL("https://haphazard.dev");
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const title = "Haphazard.dev — tools in forward motion";
const description =
	"Independent developer tools, extensions, and workflow experiments by Corwin.";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex,nofollow" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f2ff3d" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="Haphazard.dev" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#projects">Skip to projects</a>

		<header class="masthead" id="top">
			<a class="wordmark" href="/" aria-label="Haphazard.dev home">
				<span>Haphazard</span><span>.dev</span>
			</a>
			<nav aria-label="Primary navigation">
				<a href="#projects">Work</a>
				<a href="https://github.com/corwinm">Corwin / GitHub</a>
				<a href="https://github.com/HaphazardDev">HaphazardDev</a>
			</nav>
			<button class="flip" type="button" aria-pressed="false">
				<span class="flip-label">Flip colors</span><span aria-hidden="true">↻</span>
			</button>
		</header>

		<main>
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-kicker" aria-hidden="true">
					<span>Independent</span><span>Developer</span><span>Tools</span>
				</div>
				<h1 id="hero-title">
					<span>MAKE</span>
					<span class="offset">THE WORK</span>
					<span class="outline">MOVE.</span>
				</h1>
				<div class="hero-foot">
					<p class="positioning">
						Sharp tools for messy, multi-repo, keyboard-first software work.
					</p>
					<a class="down" href="#projects">
						See the projects <span aria-hidden="true">↓</span>
					</a>
				</div>
				<div class="ticker" aria-hidden="true">
					<div>
						<span>EDIT</span><i>●</i><span>SHIP</span><i>●</i><span>SYNC</span><i>●</i><span>REPEAT</span><i>●</i>
						<span>EDIT</span><i>●</i><span>SHIP</span><i>●</i><span>SYNC</span><i>●</i><span>REPEAT</span><i>●</i>
					</div>
				</div>
			</section>

			<section class="projects" id="projects" aria-labelledby="projects-title">
				<div class="projects-heading">
					<p>Selected output / 2026</p>
					<h2 id="projects-title">Four tools.<br />Zero ceremony.</h2>
					<p class="count">[ 01—{String(projects.length).padStart(2, "0")} ]</p>
				</div>

				<div class="project-list">
					{projects.map((project, index) => (
						<article class="project" id={project.slug}>
							<div class="project-bar">
								<p class="project-number">{String(index + 1).padStart(2, "0")}</p>
								<div>
									<p class="category">{project.category}</p>
									<h3>{project.title}</h3>
								</div>
								<span class="mark" aria-hidden="true">↗</span>
							</div>
							<div class="project-detail">
								<p class="description">{project.description}</p>
								<ul class="highlights" aria-label={`${project.title} highlights`}>
									{project.highlights.map((highlight) => <li>{highlight}</li>)}
								</ul>
								<div class="project-meta">
									<ul class="technologies" aria-label={`${project.title} technologies`}>
										{project.technologies.map((technology) => <li>{technology}</li>)}
									</ul>
									<div class="project-links" aria-label={`${project.title} links`}>
										{project.links.map((link) => (
											<a href={link.href} target="_blank" rel="noreferrer">
												{link.label}<span aria-hidden="true">↗</span>
											</a>
										))}
									</div>
								</div>
							</div>
						</article>
					))}
				</div>
			</section>
		</main>

		<footer>
			<p>Haphazard.dev <span>© {new Date().getFullYear()}</span></p>
			<p>Built by Corwin for the useful edge cases.</p>
			<a href="#top">Back up ↑</a>
		</footer>

		<script is:inline>
			const flipButton = document.querySelector('.flip');
			const flipLabel = document.querySelector('.flip-label');

			flipButton?.addEventListener('click', () => {
				const flipped = document.body.classList.toggle('is-flipped');
				flipButton.setAttribute('aria-pressed', String(flipped));
				if (flipLabel) flipLabel.textContent = flipped ? 'Reset colors' : 'Flip colors';
			});
		</script>
	</body>
</html>

<style is:global>
	:root {
		--ink: #101010;
		--paper: #f2ff3d;
		--shock: #4b74ff;
		--hot: #ff4a2d;
		--cream: #f5f0e7;
		font-family: Arial, Helvetica, sans-serif;
		color: var(--ink);
		background: var(--paper);
		font-synthesis: none;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		background: var(--paper);
	}

	body {
		margin: 0;
		min-width: 0;
		overflow-x: clip;
		background: var(--paper);
		color: var(--ink);
		transition: background-color 420ms ease, color 420ms ease;
	}

	body.is-flipped {
		--paper: #2457ff;
		--shock: #f2ff3d;
		--hot: #ff8069;
		--cream: #101010;
		--ink: #f8f5ec;
	}

	a {
		color: inherit;
	}

	button,
	a {
		-webkit-tap-highlight-color: transparent;
	}

	:focus-visible {
		outline: 3px solid #fff;
		outline-offset: 3px;
		box-shadow: 0 0 0 6px #101010 !important;
	}

	::selection {
		background: var(--hot);
		color: #101010;
	}

	.skip-link {
		position: fixed;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 20;
		transform: translateY(-160%);
		border: 3px solid currentColor;
		background: var(--cream);
		padding: 0.7rem 1rem;
		font-weight: 900;
		text-transform: uppercase;
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	.masthead {
		display: grid;
		grid-template-columns: minmax(12rem, 1fr) auto auto;
		align-items: center;
		gap: 2rem;
		border-bottom: 4px solid currentColor;
		padding: 1rem clamp(1rem, 3vw, 3rem);
		font-size: 0.75rem;
		font-weight: 900;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.wordmark {
		display: inline-flex;
		width: fit-content;
		text-decoration: none;
	}

	.wordmark span {
		padding: 0.35rem 0.42rem;
	}

	.wordmark span:first-child {
		background: var(--ink);
		color: var(--paper);
	}

	.wordmark span:last-child {
		background: var(--hot);
		color: #101010;
	}

	.masthead nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1.5rem;
	}

	.masthead nav a,
	.down,
	footer a {
		text-decoration-thickness: 2px;
		text-underline-offset: 0.3em;
	}

	.masthead nav a:hover,
	.down:hover,
	footer a:hover {
		text-decoration-style: double;
	}

	.flip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.7rem;
		min-width: 44px;
		min-height: 44px;
		border: 3px solid currentColor;
		border-radius: 0;
		background: transparent;
		padding: 0.65rem 0.8rem;
		color: inherit;
		font: inherit;
		text-transform: uppercase;
		box-shadow: 4px 4px 0 currentColor;
		cursor: pointer;
		transition: transform 160ms ease, box-shadow 160ms ease;
	}

	.flip:hover,
	.flip[aria-pressed="true"] {
		transform: translate(4px, 4px);
		box-shadow: 0 0 0 currentColor;
	}

	.hero {
		position: relative;
		display: grid;
		grid-template-columns: clamp(4rem, 9vw, 9rem) minmax(0, 1fr);
		min-height: calc(100svh - 74px);
		border-bottom: 4px solid currentColor;
	}

	.hero-kicker {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		border-right: 4px solid currentColor;
		padding: 1.25rem 0;
		font-size: clamp(0.62rem, 1vw, 0.8rem);
		font-weight: 900;
		letter-spacing: 0.12em;
		text-align: center;
		text-transform: uppercase;
		writing-mode: vertical-rl;
	}

	.hero h1 {
		position: relative;
		z-index: 1;
		align-self: center;
		min-width: 0;
		margin: 0;
		padding: clamp(2rem, 5vw, 5rem) clamp(1rem, 4vw, 4rem) 8rem;
		font-family: Impact, "Arial Black", Arial, sans-serif;
		font-size: clamp(4.2rem, 15.7vw, 15rem);
		font-weight: 900;
		letter-spacing: -0.065em;
		line-height: 0.69;
		text-transform: uppercase;
	}

	.hero h1 span {
		display: block;
		max-width: 100%;
	}

	.hero h1 .offset {
		color: var(--shock);
		transform: translateX(clamp(0rem, 5vw, 5rem));
	}

	.hero h1 .outline {
		color: transparent;
		-webkit-text-stroke: clamp(2px, 0.4vw, 6px) currentColor;
	}

	.hero-foot {
		position: absolute;
		right: 0;
		bottom: 0;
		left: clamp(4rem, 9vw, 9rem);
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: 2rem;
		border-top: 4px solid currentColor;
		background: var(--cream);
		color: var(--ink);
		padding: 1rem clamp(1rem, 4vw, 4rem);
	}

	.positioning {
		max-width: 48ch;
		margin: 0;
		font-size: clamp(1rem, 1.8vw, 1.5rem);
		font-weight: 800;
		line-height: 1.15;
	}

	.down {
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.ticker {
		position: absolute;
		top: 8%;
		right: 0;
		z-index: 0;
		width: min(70%, 70rem);
		overflow: hidden;
		transform: rotate(-6deg);
		background: var(--hot);
		color: #101010;
		font-size: clamp(0.8rem, 1.6vw, 1.2rem);
		font-weight: 900;
		letter-spacing: 0.1em;
		white-space: nowrap;
	}

	.ticker div {
		display: flex;
		width: max-content;
		gap: 1.2rem;
		padding: 0.55rem;
		animation: crawl 18s linear infinite;
	}

	.ticker i {
		font-style: normal;
	}

	.projects {
		background: var(--cream);
		color: var(--ink);
	}

	.projects-heading {
		display: grid;
		grid-template-columns: 1fr 2fr auto;
		align-items: start;
		gap: 2rem;
		border-bottom: 4px solid currentColor;
		padding: clamp(2rem, 5vw, 5rem) clamp(1rem, 3vw, 3rem);
	}

	.projects-heading p {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.projects-heading h2 {
		margin: 0;
		font-family: Impact, "Arial Black", Arial, sans-serif;
		font-size: clamp(3rem, 8vw, 7.8rem);
		font-weight: 900;
		letter-spacing: -0.045em;
		line-height: 0.82;
		text-transform: uppercase;
	}

	.count {
		font-size: 1rem !important;
	}

	.project {
		scroll-margin-top: 1rem;
		border-bottom: 4px solid currentColor;
	}

	.project-bar {
		display: grid;
		grid-template-columns: clamp(3.5rem, 7vw, 7rem) minmax(0, 1fr) auto;
		align-items: center;
		gap: clamp(0.8rem, 2vw, 2rem);
		min-width: 0;
		padding: clamp(1rem, 2.5vw, 2.5rem) clamp(1rem, 3vw, 3rem);
		background: var(--paper);
		transition: background-color 240ms ease, color 240ms ease;
	}

	.project:nth-child(even) .project-bar {
		background: var(--shock);
		color: var(--ink);
	}

	body.is-flipped .project-bar {
		color: var(--ink);
	}

	body.is-flipped .project:nth-child(even) .project-bar {
		color: #101010;
	}

	.project:hover .project-bar {
		background: var(--hot);
		color: #101010;
	}

	.project-number {
		align-self: start;
		margin: 0;
		font-size: clamp(1rem, 2vw, 1.8rem);
		font-weight: 900;
	}

	.category {
		margin: 0 0 0.4rem;
		font-size: clamp(0.62rem, 1vw, 0.78rem);
		font-weight: 900;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.project h3 {
		min-width: 0;
		margin: 0;
		font-family: Impact, "Arial Black", Arial, sans-serif;
		font-size: clamp(2.3rem, 8vw, 8rem);
		font-weight: 900;
		letter-spacing: -0.045em;
		line-height: 0.78;
		overflow-wrap: anywhere;
		text-transform: uppercase;
	}

	.mark {
		font-size: clamp(2.5rem, 7vw, 7rem);
		font-weight: 900;
		line-height: 0.7;
	}

	.project-detail {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) minmax(14rem, 0.8fr);
		gap: clamp(1.5rem, 4vw, 4rem);
		padding: clamp(1.5rem, 4vw, 4rem) clamp(1rem, 3vw, 3rem);
	}

	.description {
		margin: 0;
		font-size: clamp(1.2rem, 2.2vw, 2rem);
		font-weight: 800;
		line-height: 1.12;
	}

	.highlights {
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.92rem;
		font-weight: 600;
		line-height: 1.45;
	}

	.highlights li {
		border-top: 2px solid currentColor;
		padding: 0.65rem 0;
	}

	.highlights li::before {
		content: "→ ";
		font-weight: 900;
	}

	.project-meta {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 2rem;
	}

	.technologies {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.technologies li {
		border: 2px solid currentColor;
		padding: 0.35rem 0.5rem;
		font-size: 0.65rem;
		font-weight: 900;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.project-links a {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-width: 7rem;
		border-bottom: 3px solid currentColor;
		padding: 0.45rem 0;
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.04em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.project-links a:hover {
		background: var(--hot);
		color: #101010;
	}

	footer {
		display: grid;
		grid-template-columns: 1fr 2fr auto;
		gap: 2rem;
		background: var(--ink);
		color: var(--paper);
		padding: 2rem clamp(1rem, 3vw, 3rem);
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	footer p {
		margin: 0;
	}

	footer p span {
		white-space: nowrap;
	}

	@keyframes crawl {
		to { transform: translateX(-50%); }
	}

	@media (max-width: 760px) {
		.masthead {
			grid-template-columns: 1fr auto;
			gap: 0.8rem;
		}

		.masthead nav {
			grid-column: 1 / -1;
			grid-row: 2;
			justify-content: flex-start;
			border-top: 2px solid currentColor;
			padding-top: 0.75rem;
		}

		.flip-label {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
		}

		.hero {
			grid-template-columns: 2.75rem minmax(0, 1fr);
			min-height: 42rem;
		}

		.hero-kicker {
			font-size: 0.55rem;
		}

		.hero h1 {
			padding: 4rem 0.85rem 9rem;
			font-size: clamp(3.7rem, 21vw, 7rem);
			line-height: 0.76;
		}

		.hero h1 .offset {
			transform: none;
		}

		.hero-foot {
			left: 2.75rem;
			grid-template-columns: 1fr;
			gap: 0.8rem;
		}

		.ticker {
			top: 3rem;
			width: 85%;
		}

		.projects-heading {
			grid-template-columns: 1fr auto;
		}

		.projects-heading h2 {
			grid-column: 1 / -1;
			grid-row: 2;
		}

		.project-bar {
			grid-template-columns: 2.5rem minmax(0, 1fr);
		}

		.mark {
			display: none;
		}

		.project h3 {
			font-size: clamp(2.5rem, 14vw, 5rem);
			line-height: 0.84;
		}

		.project-detail {
			grid-template-columns: 1fr;
		}

		footer {
			grid-template-columns: 1fr auto;
		}

		footer p:nth-child(2) {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		*, *::before, *::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
