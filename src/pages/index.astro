---
import { projects } from "../data/projects";

const primaryLinks = [
	{ label: "GitHub", href: "https://github.com/corwinm" },
	{ label: "HaphazardDev", href: "https://github.com/HaphazardDev" },
];

const objectForms = ["aperture", "axis", "signal", "modules"];
---


<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex,nofollow" />
		<meta name="description" content="A curated collection of developer tools, extensions, and workflow experiments designed and built by Corwin." />
		<meta name="theme-color" content="#f1efe8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>Haphazard.dev — a specimen library of developer tools</title>
	</head>
	<body id="top">
	<a class="skip-link" href="#collection">Skip to collection</a>

	<header class="site-header">
		<a class="wordmark" href="/" aria-label="Haphazard.dev home">
			<span class="mark" aria-hidden="true">H/D</span>
			<span>Haphazard.dev</span>
		</a>
		<nav aria-label="Primary navigation">
			<a href="#collection">Collection</a>
			<a href="#about">About</a>
			{primaryLinks.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>
	</header>

	<main>
		<section class="hero" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="kicker">Independent software · collection 01</p>
				<h1 id="hero-title">Useful software,<br /><em>considered as objects.</em></h1>
				<p class="lede">
					A working collection of tools made for the moments between idea and implementation—
					editor gestures, coordinated worktrees, and calmer agent workflows.
				</p>
			</div>

			<a class="collection-ticket" href="#collection" aria-label={`Browse all ${projects.length} objects in the collection`}>
				<span>Permanent collection</span>
				<strong>{String(projects.length).padStart(2, "0")}</strong>
				<small>objects on view</small>
				<i aria-hidden="true">↓</i>
			</a>
		</section>

		<section id="collection" class="collection" aria-labelledby="collection-title" data-library>
			<div class="collection-heading">
				<div>
					<p class="kicker">The collection</p>
					<h2 id="collection-title">Selected instruments</h2>
				</div>
				<p class="collection-intro">
					Each specimen solves a small, recurring source of friction. Select an accession number
					to bring an object forward.
				</p>
			</div>

			<div class="catalogue-shell">
				<div class="accession-panel">
					<p class="panel-label" id="accession-label">Accession register</p>
					<div class="accession-list">
						{projects.map((project, index) => (
							<button
								type="button"
								class="accession"
								data-select={project.slug}
								aria-controls={`specimen-${project.slug}`}
								aria-pressed={index === 0 ? "true" : "false"}
							>
								<span>{String(index + 1).padStart(2, "0")}</span>
								<strong>{project.title}</strong>
								<small>{project.category}</small>
							</button>
						))}
					</div>
					<p class="register-note"><span data-position>01</span> / {String(projects.length).padStart(2, "0")} · on view</p>
				</div>

				<div class="specimen-stage" aria-live="polite">
					{projects.map((project, index) => (
						<article
							class="specimen"
							id={`specimen-${project.slug}`}
							data-specimen={project.slug}
							data-active={index === 0 ? "true" : "false"}
						>
							<div class={`object-chamber object-${objectForms[index]}`} aria-hidden="true">
								<div class="object-shadow"></div>
								<div class="object">
									<span class="object-code">{String(index + 1).padStart(2, "0")}</span>
									<span class="object-name">{project.title}</span>
								</div>
								<p>H/D—{new Date().getFullYear()}—{String(index + 1).padStart(3, "0")}</p>
							</div>

							<div class="museum-label">
								<div class="label-head">
									<p class="accession-number">H/D {String(index + 1).padStart(3, "0")}</p>
									<p>{project.category}</p>
								</div>
								<h3>{project.title}</h3>
								<p class="description">{project.description}</p>

								<div class="details-grid">
									<div>
										<h4>Design notes</h4>
										<ul>
											{project.highlights.map((highlight) => <li>{highlight}</li>)}
										</ul>
									</div>
									<div>
										<h4>Materials</h4>
										<p class="materials">{project.technologies.join(" · ")}</p>
									</div>
								</div>

								<div class="object-links" aria-label={`${project.title} links`}>
									{project.links.map((link) => (
										<a href={link.href} target="_blank" rel="noreferrer">
											{link.label}<span aria-hidden="true">↗</span>
										</a>
									))}
								</div>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<section id="about" class="about" aria-labelledby="about-title">
			<p class="kicker">Collection practice</p>
			<div>
				<h2 id="about-title">Built to be used,<br />not merely displayed.</h2>
				<p>
					Haphazard.dev is Corwin’s independent software practice. The collection follows one rule:
					make the awkward part of a technical workflow feel direct, legible, and surprisingly natural.
				</p>
				<a href="https://github.com/corwinm">Visit the studio on GitHub <span aria-hidden="true">↗</span></a>
			</div>
		</section>
	</main>

	<footer>
		<a class="wordmark" href="/" aria-label="Haphazard.dev home">
			<span class="mark" aria-hidden="true">H/D</span>
			<span>Haphazard.dev</span>
		</a>
		<p>Independent developer tools · {new Date().getFullYear()}</p>
		<a href="#top" onclick="window.scrollTo({ top: 0 }); return false;">Return to entrance ↑</a>
	</footer>

	<script is:inline>
		const library = document.querySelector("[data-library]");
		if (library) {
			library.classList.add("is-interactive");
			const buttons = [...library.querySelectorAll("[data-select]")];
			const specimens = [...library.querySelectorAll("[data-specimen]")];
			const position = library.querySelector("[data-position]");

			const selectSpecimen = (slug, updateHash = true) => {
				const next = specimens.find((item) => item.dataset.specimen === slug);
				const nextButton = buttons.find((item) => item.dataset.select === slug);
				if (!next || !nextButton) return;

				buttons.forEach((button) => button.setAttribute("aria-pressed", String(button === nextButton)));
				specimens.forEach((item) => item.dataset.active = String(item === next));
				if (position) position.textContent = String(specimens.indexOf(next) + 1).padStart(2, "0");
				if (updateHash) history.replaceState(null, "", `#${slug}`);
			};

			buttons.forEach((button) => button.addEventListener("click", () => selectSpecimen(button.dataset.select)));
			const requested = location.hash.slice(1);
			if (specimens.some((item) => item.dataset.specimen === requested)) selectSpecimen(requested, false);
		}
	</script>
	</body>
</html>

<style>
	:global(:root) {
		color-scheme: light;
		--paper: #f1efe8;
		--ink: #171816;
		--faded: #62635b;
		--rule: #c7c5bb;
		--blue: #2847d7;
		--red: #e84a32;
		--acid: #d6ef4a;
		background: var(--paper);
		color: var(--ink);
		font-family: Arial, Helvetica, sans-serif;
	}

	:global(*) { box-sizing: border-box; }
	:global(html) { min-height: 100%; margin: 0; scroll-behavior: smooth; }

	:global(html) { scroll-padding-top: 6rem; }
	:global(body) {
		min-height: 100%;
		margin: 0;
		overflow-x: hidden;
		background: var(--paper);
		color: var(--ink);
	}
	:global(a) { color: inherit; }
	:global(::selection) { background: var(--acid); color: var(--ink); }
	:global(:focus-visible) { outline: 3px solid var(--blue); outline-offset: 4px; }

	.skip-link {
		position: fixed;
		top: 1rem;
		left: 1rem;
		z-index: 20;
		transform: translateY(-180%);
		background: var(--ink);
		padding: .75rem 1rem;
		color: white;
	}
	.skip-link:focus { transform: none; }

	.site-header,
	main,
	footer {
		width: min(1380px, calc(100% - 3rem));
		margin-inline: auto;
	}

	.site-header {
		position: relative;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		border-bottom: 1px solid var(--ink);
		padding: 1.25rem 0;
	}

	.wordmark { display: inline-flex; align-items: center; gap: .7rem; font-weight: 700; text-decoration: none; }
	.mark {
		display: grid;
		place-items: center;
		width: 2.35rem;
		aspect-ratio: 1;
		background: var(--blue);
		color: white;
		font-size: .68rem;
		letter-spacing: -.04em;
	}

	nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 1.5rem; }
	nav a, footer a { color: var(--ink); font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-decoration-thickness: 1px; text-underline-offset: .25rem; text-transform: uppercase; }
	nav a:hover, footer a:hover { color: var(--blue); }

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(15rem, .5fr);
		align-items: end;
		gap: 4rem;
		min-height: 78vh;
		padding: clamp(5rem, 10vw, 9rem) 0 4rem;
	}

	.kicker, .panel-label, .accession-number {
		margin: 0 0 1.4rem;
		font-size: .7rem;
		font-weight: 700;
		letter-spacing: .17em;
		text-transform: uppercase;
	}

	h1, h2, h3, p { margin-top: 0; }
	h1 {
		max-width: 12ch;
		margin-bottom: 2.5rem;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(3.4rem, 8.3vw, 8.8rem);
		font-weight: 400;
		letter-spacing: -.065em;
		line-height: .84;
	}
	h1 em { color: var(--blue); font-weight: 400; }
	.lede { max-width: 44rem; margin: 0; color: var(--faded); font-size: clamp(1.05rem, 1.7vw, 1.4rem); line-height: 1.55; }

	.collection-ticket {
		position: relative;
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: end;
		min-height: 17rem;
		border: 1px solid var(--ink);
		background: var(--acid);
		padding: 1.5rem;
		color: var(--ink);
		text-decoration: none;
		transition: transform 200ms ease, box-shadow 200ms ease;
	}
	.collection-ticket::before { position: absolute; inset: .45rem; border: 1px solid rgba(23,24,22,.25); content: ""; pointer-events: none; }
	.collection-ticket:hover { transform: rotate(1deg) translateY(-4px); box-shadow: -9px 10px 0 var(--blue); }
	.collection-ticket span { align-self: start; font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
	.collection-ticket strong { grid-column: 1 / -1; font-family: Georgia, serif; font-size: 6rem; font-weight: 400; line-height: .8; }
	.collection-ticket small { font-size: .75rem; text-transform: uppercase; }
	.collection-ticket i { font-style: normal; font-size: 1.6rem; }

	.collection { border-top: 1px solid var(--ink); padding: 2rem 0 8rem; }
	.collection-heading { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: end; margin-bottom: 4rem; }
	.collection-heading h2, .about h2 { margin: 0; font-family: Georgia, serif; font-size: clamp(2.8rem, 5vw, 5.4rem); font-weight: 400; letter-spacing: -.055em; line-height: .93; }
	.collection-intro { max-width: 38rem; margin: 0; color: var(--faded); font-size: 1.05rem; line-height: 1.55; }

	.catalogue-shell { display: grid; grid-template-columns: minmax(15rem, .28fr) minmax(0, .72fr); min-height: 47rem; border: 1px solid var(--ink); background: #e8e5dc; }
	.accession-panel { display: flex; flex-direction: column; border-right: 1px solid var(--ink); padding: 1.5rem; }
	.panel-label { margin-bottom: 2rem; color: var(--faded); }
	.accession-list { display: grid; }
	.accession {
		display: grid;
		grid-template-columns: 2.2rem 1fr;
		gap: .2rem .75rem;
		width: 100%;
		border: 0;
		border-top: 1px solid var(--rule);
		background: transparent;
		padding: 1rem 0;
		color: var(--ink);
		font: inherit;
		text-align: left;
		cursor: pointer;
	}
	.accession:last-child { border-bottom: 1px solid var(--rule); }
	.accession span { grid-row: 1 / 3; color: var(--faded); font-size: .7rem; padding-top: .15rem; }
	.accession strong { font-family: Georgia, serif; font-size: 1.1rem; font-weight: 400; }
	.accession small { color: var(--faded); font-size: .66rem; letter-spacing: .08em; text-transform: uppercase; }
	.accession:hover strong { color: var(--blue); }
	.accession[aria-pressed="true"] { margin-inline: -.55rem; width: calc(100% + 1.1rem); background: var(--ink); padding-inline: .55rem; color: white; }
	.accession[aria-pressed="true"] span, .accession[aria-pressed="true"] small { color: #c8c7bf; }
	.register-note { margin: auto 0 0; padding-top: 2rem; color: var(--faded); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; }

	.specimen-stage { min-width: 0; }
	.specimen { display: grid; min-height: 47rem; }
	.is-interactive .specimen { display: none; }
	.is-interactive .specimen[data-active="true"] { display: grid; animation: reveal 420ms cubic-bezier(.22,.75,.2,1) both; }
	@keyframes reveal { from { opacity: 0; transform: translateY(12px); } }

	.object-chamber {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 27rem;
		overflow: hidden;
		border-bottom: 1px solid var(--ink);
		background-color: #dad7ce;
		background-image: linear-gradient(rgba(23,24,22,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(23,24,22,.08) 1px, transparent 1px);
		background-size: 2.5rem 2.5rem;
	}
	.object-chamber > p { position: absolute; right: 1rem; bottom: .8rem; margin: 0; color: var(--faded); font-size: .62rem; letter-spacing: .13em; }
	.object { position: relative; z-index: 2; display: flex; flex-direction: column; justify-content: space-between; width: clamp(11rem, 25vw, 18rem); aspect-ratio: 1; padding: 1.4rem; background: var(--blue); color: white; box-shadow: -1.4rem 1.5rem 0 rgba(23,24,22,.16); transform: rotate(-5deg); }
	.object-shadow { position: absolute; width: 25rem; height: 5rem; border-radius: 50%; background: rgba(23,24,22,.14); filter: blur(20px); transform: translateY(9rem); }
	.object-code { align-self: flex-end; font-size: .72rem; letter-spacing: .16em; }
	.object-name { max-width: 8ch; font-family: Georgia, serif; font-size: clamp(1.65rem, 4vw, 3.2rem); line-height: .9; overflow-wrap: anywhere; }
	.object-axis .object { width: clamp(8rem, 15vw, 11rem); aspect-ratio: .62; border-radius: 999px; background: var(--red); transform: rotate(20deg); }
	.object-signal .object { clip-path: polygon(50% 0, 100% 30%, 86% 100%, 14% 100%, 0 30%); background: var(--ink); transform: rotate(4deg); }
	.object-modules .object { border-radius: 45% 45% 8% 8%; background: var(--acid); color: var(--ink); transform: rotate(-2deg); }

	.museum-label { padding: 1.5rem 2rem 2rem; background: #f8f6ef; }
	.label-head { display: flex; justify-content: space-between; gap: 2rem; border-bottom: 1px solid var(--rule); margin-bottom: 1.3rem; }
	.label-head p { margin-bottom: .75rem; color: var(--faded); font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; }
	.museum-label h3 { margin-bottom: .7rem; font-family: Georgia, serif; font-size: clamp(2.3rem, 4vw, 4.4rem); font-weight: 400; letter-spacing: -.055em; line-height: .9; overflow-wrap: anywhere; }
	.description { max-width: 52rem; color: var(--faded); line-height: 1.55; }
	.details-grid { display: grid; grid-template-columns: 1.4fr .6fr; gap: 3rem; border-top: 1px solid var(--rule); padding-top: 1rem; }
	h4 { margin: 0 0 .75rem; font-size: .65rem; letter-spacing: .14em; text-transform: uppercase; }
	.details-grid ul { margin: 0; padding-left: 1rem; color: var(--faded); font-size: .86rem; line-height: 1.5; }
	.details-grid li + li { margin-top: .35rem; }
	.materials { margin: 0; color: var(--faded); font-size: .78rem; line-height: 1.5; }
	.object-links { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.5rem; }
	.object-links a { display: inline-flex; align-items: center; justify-content: space-between; gap: 2rem; min-width: 9rem; border: 1px solid var(--ink); padding: .7rem .85rem; color: var(--ink); font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
	.object-links a:hover { background: var(--blue); color: white; }

	.about { display: grid; grid-template-columns: .35fr .65fr; gap: 4rem; border-top: 1px solid var(--ink); padding: 7rem 0; }
	.about > div { max-width: 53rem; }
	.about h2 { margin-bottom: 2rem; }
	.about div p { max-width: 42rem; color: var(--faded); font-size: 1.15rem; line-height: 1.6; }
	.about div a { display: inline-block; margin-top: 1rem; border-bottom: 1px solid var(--ink); padding-bottom: .35rem; color: var(--ink); font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-decoration: none; text-transform: uppercase; }

	footer { display: flex; align-items: center; justify-content: space-between; gap: 2rem; border-top: 1px solid var(--ink); padding: 2rem 0 3rem; }
	footer p { margin: 0; color: var(--faded); font-size: .7rem; letter-spacing: .09em; text-transform: uppercase; }

	@media (max-width: 880px) {
		.site-header, main, footer { width: min(100% - 2rem, 1380px); }
		.site-header { align-items: flex-start; }
		nav { gap: .75rem 1rem; }
		.hero { grid-template-columns: 1fr; gap: 3rem; min-height: auto; }
		.collection-ticket { width: min(100%, 20rem); }
		.collection-heading { grid-template-columns: 1fr; gap: 1.5rem; }
		.catalogue-shell { grid-template-columns: 1fr; }
		.accession-panel { border-right: 0; border-bottom: 1px solid var(--ink); }
		.accession-list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1.5rem; }
		.register-note { margin-top: 1rem; }
		.about { grid-template-columns: 1fr; gap: 1rem; }
	}

	@media (max-width: 580px) {
		.site-header { display: grid; gap: 1.25rem; }
		nav { justify-content: flex-start; }
		nav a { min-height: 2rem; display: inline-flex; align-items: center; }
		.hero { padding-top: 5rem; }
		h1 { font-size: clamp(3.1rem, 16vw, 5rem); }
		.collection { padding-bottom: 5rem; }
		.accession-list { grid-template-columns: 1fr; }
		.object-chamber { min-height: 21rem; }
		.museum-label { padding-inline: 1.1rem; }
		.label-head, .details-grid { grid-template-columns: 1fr; display: grid; gap: .6rem; }
		.object-links a { flex: 1 1 9rem; }
		.about { padding-block: 5rem; }
		footer { align-items: flex-start; flex-direction: column; }
	}

	@media (prefers-reduced-motion: reduce) {
		.is-interactive .specimen[data-active="true"] { animation: none; }
	}
</style>
