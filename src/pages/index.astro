---
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects";

const primaryLinks = [
	{ label: "GitHub", href: "https://github.com/corwinm" },
	{ label: "HaphazardDev", href: "https://github.com/HaphazardDev" },
];

const instrumentCues: Record<string, { command: string; operations: string[] }> = {
	"oil-code": {
		command: "filesystem / editable buffer",
		operations: ["create", "move", "rename", "delete", "preview", "navigate"],
	},
	arashi: {
		command: "meta-repo / coordinated worktrees",
		operations: ["create", "switch", "sync", "setup"],
	},
	"coding-agents-tmux": {
		command: "agent sessions / tmux",
		operations: ["busy", "idle", "waiting", "jump", "popup", "status"],
	},
	"pi-extensions": {
		command: "pi / installable extensions",
		operations: ["ask", "copy", "review", "vim quit"],
	},
};
---

<Layout
	title="Haphazard.dev — Instrument Archive"
	description="An instrument archive of developer tools, extensions, CLIs, and workflow experiments designed and built by Corwin."
	robots="noindex,nofollow"
	themeColor="#f3f0e6"
>
		<span id="top" class="top-anchor" aria-hidden="true"></span>
		<a class="skip-link" href="#archive">Skip to project archive</a>

		<header class="site-header">
			<a class="wordmark" href="/" aria-label="Haphazard.dev home">
				<span class="monogram" aria-hidden="true">H/D</span>
				<span>Haphazard.dev</span>
			</a>
			<nav aria-label="Primary navigation">
				<a href="#archive">Archive</a>
				<a href="#practice">Practice</a>
				{primaryLinks.map((link) => <a href={link.href}>{link.label}</a>)}
			</nav>
		</header>

		<main>
			<section class="intro" aria-labelledby="page-title">
				<div class="intro-index" aria-hidden="true">
					<span>IA</span>
					<strong>{String(projects.length).padStart(2, "0")}</strong>
					<small>working tools</small>
				</div>
				<div class="intro-copy">
					<p class="eyebrow">Instrument archive · developer workflow</p>
					<h1 id="page-title">Tools for the work<br />around <em>the work.</em></h1>
					<p class="lede">
						A compact catalogue of software for editing files, coordinating worktrees, and keeping
						coding-agent sessions within reach. Built by Corwin for real development workflows.
					</p>
				</div>
				<a class="archive-jump" href="#archive">
					<span>Open the archive</span>
					<span aria-hidden="true">↓</span>
				</a>
			</section>

			<section id="archive" class="archive" aria-labelledby="archive-title">
				<header class="archive-heading">
					<div>
						<p class="eyebrow">Complete register</p>
						<h2 id="archive-title">Working instruments</h2>
					</div>
					<p>
						Every project is shown in full. Scan the operation line, read the notes, or go directly
						to source, documentation, and package listings.
					</p>
				</header>

				<div class="project-grid">
					{projects.map((project, index) => {
						const cue = instrumentCues[project.slug] ?? {
							command: project.category,
							operations: project.technologies,
						};
						const accession = `IA–${String(index + 1).padStart(3, "0")}`;
						return (
							<article class="instrument" id={project.slug}>
								<header class="instrument-header">
									<p class="accession">{accession}</p>
									<p>{project.category}</p>
								</header>

								<div class="instrument-plate" aria-label={`${project.title}: ${cue.command}`}>
									<p class="plate-command">{cue.command}</p>
									<h3>{project.title}</h3>
									<div class="operation-line" aria-label="Supported operations">
										{cue.operations.map((operation, operationIndex) => (
											<span>
												<small>{String(operationIndex + 1).padStart(2, "0")}</small>
												{operation}
											</span>
										))}
									</div>
								</div>

								<div class="instrument-body">
									<p class="description">{project.description}</p>

									<div class="instrument-details">
										<div>
											<h4>Use notes</h4>
											<ul>
												{project.highlights.map((highlight) => <li>{highlight}</li>)}
											</ul>
										</div>
										<div>
											<h4>Built with</h4>
											<p class="technologies">{project.technologies.join(" · ")}</p>
										</div>
									</div>
								</div>

								<footer class="instrument-links" aria-label={`${project.title} links`}>
									{project.links.map((link) => (
										<a href={link.href} target="_blank" rel="noreferrer">
											{link.label}<span aria-hidden="true">↗</span>
										</a>
									))}
								</footer>
							</article>
						);
					})}
				</div>
			</section>

			<section id="practice" class="practice" aria-labelledby="practice-title">
				<p class="eyebrow">The practice</p>
				<div>
					<h2 id="practice-title">Make recurring friction direct.</h2>
					<p>
						Haphazard.dev is Corwin’s independent software practice: pragmatic extensions, CLIs,
						and integrations designed to make technical workflows more legible and keyboard friendly.
					</p>
					<a href="https://github.com/corwinm">Browse all work on GitHub <span aria-hidden="true">↗</span></a>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="wordmark" href="/" aria-label="Haphazard.dev home">
				<span class="monogram" aria-hidden="true">H/D</span>
				<span>Haphazard.dev</span>
			</a>
			<p>Independent developer tools · {new Date().getFullYear()}</p>
			<a href="#top">Back to top ↑</a>
		</footer>
</Layout>

<style>
	:global(:root) {
		color-scheme: light;
		--paper: #f3f0e6;
		--paper-raised: #faf8f1;
		--ink: #171713;
		--muted: #65645d;
		--rule: #bdb9ad;
		--rule-dark: #282822;
		--accent: #ee4b2b;
		--accent-ink: #b43721;
		background: var(--paper);
		color: var(--ink);
		font-family: Arial, Helvetica, sans-serif;
	}
	.top-anchor { position: absolute; top: 0; left: 0; }

	:global(*) { box-sizing: border-box; }
	:global(html) { min-height: 100%; margin: 0; scroll-behavior: smooth; scroll-padding-top: 1.5rem; }
	:global(body) {
		min-width: 0;
		min-height: 100%;
		margin: 0;
		overflow-x: hidden;
		background: var(--paper);
		color: var(--ink);
	}
	:global(a) { color: inherit; }
	:global(::selection) { background: var(--accent); color: white; }
	:global(:focus-visible) { outline: 3px solid var(--accent); outline-offset: 4px; }

	.skip-link {
		position: fixed;
		top: 1rem;
		left: 1rem;
		z-index: 20;
		display: inline-flex;
		min-height: 44px;
		align-items: center;
		transform: translateY(-180%);
		background: var(--ink);
		padding: .8rem 1rem;
		color: white;
		font-weight: 700;
	}
	.skip-link:focus { transform: none; }

	.site-header,
	main,
	.site-footer {
		width: min(1360px, calc(100% - 3rem));
		margin-inline: auto;
	}

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		border-bottom: 1px solid var(--rule-dark);
		padding: 1.1rem 0;
	}

	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: .7rem;
		min-height: 44px;
		font-weight: 700;
		text-decoration: none;
	}
	.monogram {
		display: grid;
		place-items: center;
		width: 2.35rem;
		aspect-ratio: 1;
		background: var(--ink);
		color: white;
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: .65rem;
		letter-spacing: -.03em;
	}

	nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .25rem 1.5rem; }
	nav a,
	.site-footer > a:last-child {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-size: .72rem;
		font-weight: 700;
		letter-spacing: .1em;
		text-decoration-thickness: 1px;
		text-underline-offset: .25rem;
		text-transform: uppercase;
	}
	nav a:hover,
	.site-footer > a:last-child:hover { color: var(--accent-ink); }

	.intro {
		display: grid;
		grid-template-columns: minmax(8rem, .28fr) minmax(0, 1fr) minmax(11rem, .32fr);
		align-items: end;
		gap: clamp(2rem, 5vw, 5rem);
		border-bottom: 1px solid var(--rule-dark);
		padding: clamp(3.5rem, 7vw, 6.5rem) 0 3.25rem;
	}
	.intro-index {
		display: grid;
		align-content: space-between;
		min-height: 12rem;
		border: 1px solid var(--rule-dark);
		padding: 1rem;
		font-family: "SFMono-Regular", Consolas, monospace;
	}
	.intro-index span,
	.intro-index small { font-size: .63rem; letter-spacing: .14em; text-transform: uppercase; }
	.intro-index strong { color: var(--accent); font-family: Georgia, "Times New Roman", serif; font-size: 5.5rem; font-weight: 400; line-height: .7; }

	.eyebrow,
	.accession,
	.instrument-header p,
	h4,
	.plate-command {
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: .65rem;
		font-weight: 700;
		letter-spacing: .13em;
		text-transform: uppercase;
	}
	.eyebrow { margin: 0 0 1.2rem; }
	h1,
	h2,
	h3,
	p { margin-top: 0; }
	h1,
	h2,
	h3 { font-family: Georgia, "Times New Roman", serif; font-weight: 400; }
	h1 {
		max-width: 13ch;
		margin-bottom: 1.6rem;
		font-size: clamp(3.5rem, 7.2vw, 7.2rem);
		letter-spacing: -.06em;
		line-height: .86;
	}
	h1 em { color: var(--accent); font-weight: 400; }
	.lede { max-width: 52rem; margin-bottom: 0; color: var(--muted); font-size: clamp(1rem, 1.5vw, 1.25rem); line-height: 1.55; }
	.archive-jump {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 54px;
		border-top: 1px solid var(--rule-dark);
		border-bottom: 1px solid var(--rule-dark);
		padding: .6rem 0;
		font-size: .72rem;
		font-weight: 700;
		letter-spacing: .1em;
		text-decoration: none;
		text-transform: uppercase;
	}
	.archive-jump span:last-child { color: var(--accent); font-size: 1.25rem; }
	.archive-jump:hover { color: var(--accent-ink); }

	.archive { padding: 2rem 0 7rem; }
	.archive-heading {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: end;
		gap: 3rem;
		margin-bottom: 3rem;
	}
	.archive-heading h2,
	.practice h2 {
		margin: 0;
		font-size: clamp(2.8rem, 5vw, 5.3rem);
		letter-spacing: -.055em;
		line-height: .9;
	}
	.archive-heading > p { max-width: 39rem; margin: 0; color: var(--muted); line-height: 1.6; }

	.project-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		border-top: 1px solid var(--rule-dark);
		border-left: 1px solid var(--rule-dark);
	}
	.instrument {
		min-width: 0;
		scroll-margin-top: 1.5rem;
		border-right: 1px solid var(--rule-dark);
		border-bottom: 1px solid var(--rule-dark);
		background: var(--paper-raised);
	}
	.instrument-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 3.25rem;
		border-bottom: 1px solid var(--rule);
		padding: .7rem 1rem;
	}
	.instrument-header p { margin: 0; color: var(--muted); }
	.instrument-header .accession { color: var(--accent-ink); }

	.instrument-plate {
		display: grid;
		align-content: space-between;
		min-height: 20rem;
		border-bottom: 1px solid var(--rule-dark);
		background-color: #e4e0d4;
		background-image:
			linear-gradient(rgba(23, 23, 19, .08) 1px, transparent 1px),
			linear-gradient(90deg, rgba(23, 23, 19, .08) 1px, transparent 1px);
		background-size: 2rem 2rem;
		padding: 1.25rem;
	}
	.plate-command { justify-self: end; margin: 0; color: var(--muted); text-align: right; }
	.instrument-plate h3 {
		max-width: 100%;
		margin: 2.5rem 0;
		font-size: clamp(3rem, 5.2vw, 6rem);
		letter-spacing: -.065em;
		line-height: .8;
		overflow-wrap: anywhere;
	}
	.operation-line {
		display: flex;
		align-items: stretch;
		overflow: hidden;
		border: 1px solid var(--rule-dark);
		background: var(--paper-raised);
	}
	.operation-line span {
		display: grid;
		flex: 1 1 auto;
		gap: .3rem;
		min-width: 0;
		border-right: 1px solid var(--rule-dark);
		padding: .55rem .6rem;
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: clamp(.52rem, .8vw, .68rem);
		text-transform: uppercase;
	}
	.operation-line span:last-child { border-right: 0; }
	.operation-line small { color: var(--accent-ink); font-size: .55rem; }

	.instrument-body { padding: 1.35rem; }
	.description { max-width: 57ch; margin-bottom: 1.5rem; color: var(--muted); line-height: 1.55; }
	.instrument-details {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(8rem, .65fr);
		gap: 2rem;
		border-top: 1px solid var(--rule);
		padding-top: 1rem;
	}
	h4 { margin: 0 0 .75rem; }
	.instrument-details ul { margin: 0; padding-left: 1rem; color: var(--muted); font-size: .86rem; line-height: 1.5; }
	.instrument-details li + li { margin-top: .4rem; }
	.technologies { margin: 0; color: var(--muted); font-size: .8rem; line-height: 1.55; }

	.instrument-links { display: flex; flex-wrap: wrap; border-top: 1px solid var(--rule-dark); }
	.instrument-links a {
		display: inline-flex;
		flex: 1 1 8rem;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 48px;
		border-right: 1px solid var(--rule-dark);
		padding: .65rem .8rem;
		font-size: .67rem;
		font-weight: 700;
		letter-spacing: .09em;
		text-decoration: none;
		text-transform: uppercase;
	}
	.instrument-links a:last-child { border-right: 0; }
	.instrument-links a:hover { background: var(--accent-ink); color: white; }

	.practice {
		display: grid;
		grid-template-columns: .34fr .66fr;
		gap: 4rem;
		border-top: 1px solid var(--rule-dark);
		padding: 6.5rem 0;
	}
	.practice > div { max-width: 52rem; }
	.practice h2 { margin-bottom: 1.8rem; }
	.practice div p { max-width: 42rem; color: var(--muted); font-size: 1.12rem; line-height: 1.6; }
	.practice div a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		margin-top: .5rem;
		border-bottom: 1px solid var(--ink);
		font-size: .72rem;
		font-weight: 700;
		letter-spacing: .1em;
		text-decoration: none;
		text-transform: uppercase;
	}
	.practice div a:hover { color: var(--accent-ink); }

	.site-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		border-top: 1px solid var(--rule-dark);
		padding: 1.5rem 0 2.5rem;
	}
	.site-footer p { margin: 0; color: var(--muted); font-size: .66rem; letter-spacing: .09em; text-transform: uppercase; }

	@media (max-width: 900px) {
		.intro { grid-template-columns: 8rem minmax(0, 1fr); }
		.intro-index { grid-row: span 2; }
		.archive-jump { grid-column: 2; }
		.project-grid { grid-template-columns: 1fr; }
	}

	@media (max-width: 620px) {
		.site-header,
		main,
		.site-footer { width: min(100% - 2rem, 1360px); }
		.site-header { display: grid; gap: .5rem; }
		nav { justify-content: flex-start; gap: 0 .9rem; }
		nav a { min-height: 44px; }
		.intro { grid-template-columns: 1fr; gap: 2rem; padding-top: 3rem; }
		.intro-index { grid-row: auto; width: 8.5rem; min-height: 8.5rem; }
		.intro-index strong { font-size: 4rem; }
		h1 { font-size: clamp(3.25rem, 16vw, 5rem); }
		.archive-jump { grid-column: auto; }
		.archive { padding-bottom: 5rem; }
		.archive-heading { grid-template-columns: 1fr; gap: 1.25rem; }
		.instrument-header { align-items: flex-start; }
		.instrument-header p:last-child { max-width: 50%; text-align: right; }
		.instrument-plate { min-height: 17rem; padding: 1rem; }
		.instrument-plate h3 { font-size: clamp(2.8rem, 15vw, 4.5rem); }
		.operation-line { flex-wrap: wrap; }
		.operation-line span { flex: 1 1 33%; border-bottom: 1px solid var(--rule-dark); }
		.operation-line span:nth-last-child(-n + 3) { border-bottom: 0; }
		.instrument-details { grid-template-columns: 1fr; gap: 1.4rem; }
		.instrument-links a { min-height: 50px; }
		.practice { grid-template-columns: 1fr; gap: 1rem; padding: 5rem 0; }
		.site-footer { align-items: flex-start; flex-direction: column; gap: 1rem; }
	}

	@media (max-width: 390px) {
		.operation-line span { flex-basis: 50%; }
		.operation-line span:nth-last-child(-n + 3) { border-bottom: 1px solid var(--rule-dark); }
		.operation-line span:nth-last-child(-n + 2) { border-bottom: 0; }
	}

	@media (prefers-reduced-motion: reduce) {
		:global(html) { scroll-behavior: auto; }
		:global(*),
		:global(*::before),
		:global(*::after) { transition-duration: .01ms !important; animation-duration: .01ms !important; }
	}
</style>
